# Copy to .env only if you want to override. Every value below is the default
# that `config.ts` already applies, so the gateway runs with no .env at all.

# --- server ---
PORT=8080
LOG_LEVEL=info

# --- pairs (R1) ---
# Comma-separated Binance symbols. Adding one works without a code change;
# pairs outside src/market/pairSeed.ts just render with default metadata.
PAIRS=BTCUSDT,ETHUSDT,SOLUSDT,DOGEUSDT,XRPUSDT

# --- emit cadence (R5) ---
# The brief specifies 100ms. The mockup's Update Frequency slider shows 250ms;
# the brief wins. Clamped to 10-1000 at runtime, including over the WebSocket.
EMIT_INTERVAL_MS=100

# --- upstream ---
# data-stream.binance.vision is the public market-data host: no auth and fewer
# regional restrictions than stream.binance.com, which is geo-blocked in
# several countries. Change only if you have a reason.
BINANCE_WS_HOST=data-stream.binance.vision
DEPTH_LEVELS=20
RECONNECT_BASE_MS=500
RECONNECT_MAX_MS=15000
# A socket that stops delivering without closing is the failure that actually
# happens; this watchdog converts that silent hang into a reconnect.
UPSTREAM_STALL_TIMEOUT_MS=30000

# --- slow-consumer policy (R6) ---
# Per-socket send budget. Over this, the next frame is skipped rather than
# queued - safe because conflation means the following tick carries current
# state rather than a backlog.
MAX_BUFFERED_BYTES=1048576
# Consecutive over-budget ticks before terminate(). At 100ms that is 5s of a
# client making no progress at all.
MAX_CONSECUTIVE_SKIPS=50
HEARTBEAT_INTERVAL_MS=30000

# --- load generator (R20) ---
# SYNTHETIC_LOAD=1 replaces Binance with a local generator. Two uses: it makes
# the performance claim demonstrable (ingest ~2000/s while emit stays at 10/s),
# and it is the guaranteed-working demo mode if Binance is unreachable.
SYNTHETIC_LOAD=0
SYNTHETIC_MSGS_PER_SEC=2000

STATS_INTERVAL_MS=1000
